      "css": ".ds-button-primary{font-family:\"Inter Variable\",Inter,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:8px 14px;border:1px solid transparent;border-radius:6px;font-size:.8125rem;font-weight:550;background:var(--green, #8a5638);color:var(--primary-foreground, #ffffff);cursor:pointer}.ds-button-primary:hover:not(:disabled){filter:brightness(.95);}.ds-button-primary:focus-visible{outline:2px solid var(--green, #8a5638);outline-offset:3px;}.ds-button-primary:disabled{opacity:.48;cursor:default}"
