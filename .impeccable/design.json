      "css": ".ds-document{display:block;width:100%;text-align:left;min-height:190px;padding:23px 25px 18px;border:1px solid var(--line,#e1ddd7);border-radius:4px 13px 13px 13px;background:var(--panel,#fff);cursor:pointer;color:var(--ink,#242329);font-family:\"Inter Variable\",Inter,ui-sans-serif,system-ui,sans-serif;}.ds-document>svg{color:var(--green,#75529a);margin-bottom:15px;}.ds-document h3{font-size:1.125rem;font-weight:550;line-height:1.4;margin:0 0 8px;}.ds-document p{font-size:.8125rem;margin:0 0 10px;color:var(--ink-muted,#69636d);}.ds-document span{font-size:.8125rem;color:var(--green,#75529a);}.ds-document:hover{border-color:var(--green,#75529a);}.ds-document:focus-visible{outline:2px solid var(--green,#75529a);outline-offset:3px;}.ds-document:active{scale:.985;}"
