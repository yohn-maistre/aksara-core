{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "aksara.surface/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,79}$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,79}$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_ids": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "language": {
      "type": "string",
      "const": "openui-text-cards/1"
    },
    "program": {
      "type": "string",
      "maxLength": 7000
    }
  },
  "required": [
    "protocol",
    "id",
    "pack_id",
    "scope_ref",
    "source_ids",
    "revision",
    "expires_at",
    "language",
    "program"
  ],
  "additionalProperties": false
}
