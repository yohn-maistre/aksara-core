{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aksara",
  "version": "0.3.0",
  "identifier": "org.abstraksi.aksara",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../../dist/aksara-windows-x64/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "2026 Abstraksi contributors",
    "category": "Productivity",
    "shortDescription": "Your local AI workspace",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
